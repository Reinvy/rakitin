// <%= moduleName %> Controller
const { getAll } = require("../services/<%= kebabName %>.service");

exports.getAll = async (req, res, next) => {
  try {
    const data = await getAll(req);
    res.status(200).json({
      message: "Berhasil mendapatkan data",
      data,
    });
  } catch (err) {
    next(err);
  }
};