// <%= moduleName %> Service (No ORM - in-memory store)
// Replace the in-memory operations with real database calls when ready.


const <%= storeName %> = [];

async function getAll(req) {
  const { page = 1, limit = 10 } = req.query;
  const start = (Number(page) - 1) * Number(limit);
  const items = <%= storeName %>.slice(start, start + Number(limit));
  return { items, total: <%= storeName %>.length };
}

async function getById(req) {
  const { id } = req.params;
  return <%= storeName %>.find((item) => item.id === id) || null;
}

async function create(req) {
  const item = { id: Date.now().toString(), ...req.body };
  <%= storeName %>.push(item);
  return item;
}

async function update(req) {
  const { id } = req.params;
  const index = <%= storeName %>.findIndex((item) => item.id === id);
  if (index === -1) return null;
  <%= storeName %>[index] = { ...<%= storeName %>[index], ...req.body };
  return <%= storeName %>[index];
}

async function remove(req) {
  const { id } = req.params;
  const index = <%= storeName %>.findIndex((item) => item.id === id);
  if (index === -1) return null;
  return <%= storeName %>.splice(index, 1)[0];
}

module.exports = { getAll, getById, create, update, remove };