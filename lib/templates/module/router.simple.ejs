// <%= moduleName %> Router
const express = require("express");
const router = express.Router();
const controller = require("./<%= kebabName %>.controller");

<%= resourceStart %>
<%= resourceEnd %>

<% routes.forEach(function (route) { -%>
router.<%= route.method %>("<%= route.path %>", controller.<%= route.verb %>);
<% }); -%>

module.exports = router;
