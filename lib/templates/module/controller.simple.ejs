// <%= moduleName %> Controller
const service = require("./<%= kebabName %>.service");
<% verbs.forEach(function (verb) { -%>

exports.<%= verb %> = async (req, res, next) => {
  try {
    const data = await service.<%= verb %>(req);
    res.status(<%= verb === "create" ? 201 : 200 %>).json({
      message: "<%= messages[verb] %>",
      data,
    });
  } catch (err) {
    next(err);
  }
};
<% }); -%>
