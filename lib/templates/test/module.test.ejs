/**
 * <%= kebab %> module tests — generated by rakitin.
 *
 * Structural checks always run and only need `fs`/`path`. The HTTP smoke is
 * gated: set SKIP_HTTP_TESTS=1 (CI default) to skip it without needing
 * `express`/`supertest` installed.
 */
const fs = require("fs");
const path = require("path");

const MODULE_DIR = path.join(__dirname, "..", "..", "app", "modules", "<%= kebab %>");

/** First existing candidate path under the module directory, or null. */
function firstExisting(candidates) {
  return (
    candidates
      .map((candidate) => path.join(MODULE_DIR, candidate))
      .find((candidate) => fs.existsSync(candidate)) || null
  );
}

describe("<%= kebab %> module structure", () => {
  test("module directory exists", () => {
    expect(fs.existsSync(MODULE_DIR)).toBe(true);
  });

  test("controller file exists", () => {
    expect(
      firstExisting([
        "<%= kebab %>.controller.js",
        path.join("controllers", "<%= kebab %>.controller.js"),
      ])
    ).not.toBeNull();
  });

  test("router file exists", () => {
    expect(
      firstExisting([
        "<%= kebab %>.router.js",
        path.join("routes", "<%= kebab %>.router.js"),
      ])
    ).not.toBeNull();
  });
});

const describeHttp = process.env.SKIP_HTTP_TESTS === "1" ? describe.skip : describe;

describeHttp("GET /api/<%= kebab %> (HTTP smoke)", () => {
  let request;
  let app;

  beforeAll(() => {
    request = require("supertest");
    const express = require("express");
    const routerPath =
      firstExisting([
        "<%= kebab %>.router.js",
        path.join("routes", "<%= kebab %>.router.js"),
      ]) || path.join(MODULE_DIR, "<%= kebab %>.router.js");
    const router = require(routerPath);

    app = express();
    app.use(express.json());
    app.use("/api/<%= kebab %>", router);
  });

  test("responds with 200", async () => {
    const response = await request(app).get("/api/<%= kebab %>");
    expect(response.status).toBe(200);
  });
});
