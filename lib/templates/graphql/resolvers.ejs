/**
 * Service functions expect a web-style request object. GraphQL passes the
 * field arguments, so expose them as query/params/body at once.
 * @param {Function} fn service function: (req) => Promise<unknown>
 * @param {object} args GraphQL field arguments
 * @returns {Promise<unknown>}
 */
const callService = (fn, args) => fn({ query: args, params: args, body: args });

/** Normalize a list response into the `{ items, total }` shape. */
const toList = (value) => {
  if (Array.isArray(value)) return { items: value, total: value.length };
  if (value && Array.isArray(value.items)) return value;
  if (value === null || value === undefined) return { items: [], total: 0 };
  return { items: [value], total: 1 };
};

