// <%= pascalName %> Validation Schema (generated by rakitin)
// Sumber field: <%- source %>. Tipe yang dideklarasikan selalu menang.
const Joi = require("joi");

const fieldsSchema = {
<% fields.forEach(function (field) { -%>
  <%- field.key %>: Joi.<%- field.joi %><%- field.required ? ".required()" : ".optional()" %>,
<% }); -%>
};

const <%= camelName %>Schema = Joi.object(fieldsSchema);

const <%= camelName %>CreateSchema = <%= camelName %>Schema.keys({
<% requiredFields.forEach(function (field) { -%>
  <%- field.key %>: Joi.<%- field.joi %>.required(),
<% }); -%>
});

const <%= camelName %>UpdateSchema = <%= camelName %>Schema.keys({
<% optionalFields.forEach(function (field) { -%>
  <%- field.key %>: Joi.<%- field.joi %>.optional(),
<% }); -%>
}).min(1);

module.exports = {
  schemas: {
    <%= camelName %>Schema,
    <%= camelName %>CreateSchema,
    <%= camelName %>UpdateSchema,
  },
  <%= camelName %>Schema,
  <%= camelName %>CreateSchema,
  <%= camelName %>UpdateSchema,
};
