// Common Validation Schemas (generated by rakitin)
// Building block Joi + schema umum yang bisa dipakai ulang lintas modul.
const Joi = require("joi");

const email = Joi.string().email();
const uuid = Joi.string().uuid();
const date = Joi.date().iso();
const url = Joi.string().uri();
const number = Joi.number();
const string = Joi.string();
const boolean = Joi.boolean();

const commonSchemas = {
  pagination: Joi.object({
    page: Joi.number().integer().min(1).default(1),
    limit: Joi.number().integer().min(1).max(100).default(10),
    sort: Joi.string().default("-createdAt"),
    search: Joi.string().allow(""),
  }),
  filter: Joi.object({
    status: Joi.string().valid("active", "inactive", "pending"),
    createdFrom: Joi.date().iso(),
    createdTo: Joi.date().iso(),
  }),
  id: Joi.alternatives().try(Joi.number().integer(), uuid),
};

// Alias kompatibel untuk kode yang sudah memakai nama lama.
const idSchema = commonSchemas.id;
const paginationSchema = commonSchemas.pagination;
const filterSchema = commonSchemas.filter;

// Schema auth (dipakai `rakitin recipe auth` bila validator modul belum ada).
const registerSchema = Joi.object({
  email: email.required().messages({
    "string.email": "Format email tidak valid",
    "any.required": "Email wajib diisi",
  }),
  password: Joi.string().min(8).max(72).required().messages({
    "string.min": "Password minimal 8 karakter",
    "any.required": "Password wajib diisi",
  }),
  name: Joi.string().min(2).max(64).optional(),
  role: Joi.string().valid("user", "admin").optional(),
});

const loginSchema = Joi.object({
  email: email.required().messages({
    "string.email": "Format email tidak valid",
    "any.required": "Email wajib diisi",
  }),
  password: Joi.string().required().messages({
    "any.required": "Password wajib diisi",
  }),
});

const updateProfileSchema = Joi.object({
  name: Joi.string().min(2).max(64).optional(),
  email: email.optional(),
}).min(1);

const changePasswordSchema = Joi.object({
  oldPassword: Joi.string().required().messages({
    "any.required": "Password lama wajib diisi",
  }),
  newPassword: Joi.string().min(8).max(72).required().messages({
    "string.min": "Password baru minimal 8 karakter",
    "any.required": "Password baru wajib diisi",
  }),
});

module.exports = {
  email,
  uuid,
  date,
  url,
  number,
  string,
  boolean,
  commonSchemas,
  idSchema,
  paginationSchema,
  filterSchema,
  registerSchema,
  loginSchema,
  updateProfileSchema,
  changePasswordSchema,
};
