// Util: number
function clamp(n, min, max) {
  return Math.min(Math.max(Number(n), min), max);
}

function isEven(n) {
  return Number(n) % 2 === 0;
}

function isOdd(n) {
  return Number(n) % 2 !== 0;
}

function randomInt(min, max) {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

function toCurrency(n, currency = "IDR") {
  return new Intl.NumberFormat("id-ID", { style: "currency", currency }).format(Number(n));
}

module.exports = { clamp, isEven, isOdd, randomInt, toCurrency };
