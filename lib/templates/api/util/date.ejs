// Util: date
const dayjs = require("dayjs");

function now() {
  return dayjs().toISOString();
}

function format(date, pattern = "YYYY-MM-DD") {
  return dayjs(date).format(pattern);
}

function add(date, unit, amount) {
  return dayjs(date).add(amount, unit).toISOString();
}

function subtract(date, unit, amount) {
  return dayjs(date).subtract(amount, unit).toISOString();
}

function isBefore(a, b) {
  return dayjs(a).isBefore(dayjs(b));
}

function isAfter(a, b) {
  return dayjs(a).isAfter(dayjs(b));
}

module.exports = { now, format, add, subtract, isBefore, isAfter };
