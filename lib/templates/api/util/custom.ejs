// Util: <%= name %> (custom)
// Helper khusus proyek ini - perluas sesuai kebutuhan.

/**
 * Terapkan `transform` ke `value` dengan aman (null/undefined dilewatkan).
 * @template T
 * @param {T} value
 * @param {(value: T) => T} transform
 * @returns {T}
 */
function <%= camelName %>(value, transform) {
  if (value === null || value === undefined) return value;
  return typeof transform === "function" ? transform(value) : value;
}

module.exports = { <%= camelName %> };
