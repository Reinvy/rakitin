// Util: validation
function isEmail(str) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(str ?? ""));
}

function isUrl(str) {
  try {
    new URL(String(str));
    return true;
  } catch {
    return false;
  }
}

function isUuid(str) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(str ?? ""));
}

module.exports = { isEmail, isUrl, isUuid };
