// <%= resource %> Resource Controller (modul: <%= kebabModule %>)
// Endpoint CRUD mandiri dengan in-memory store.
// Ganti `store` dengan service/ORM modul bila model database sudah siap.

const store = [];

const FIELD_TYPES = {
<% fields.forEach(function (field) { -%>
  <%- field.key %>: <%- field.literal %>,
<% }); -%>
};

const SEARCH_FIELDS = [<%- searchFields.map(function (field) { return JSON.stringify(field); }).join(", ") %>];

function cast(type, value) {
  if (value === undefined || value === null || value === "") return value;
  if (type === "number") return Number(value);
  if (type === "boolean") return value === true || value === "true";
  return String(value);
}

function applySearch(items, term) {
  const needle = String(term || "").trim().toLowerCase();
  if (!needle) return items;
  return items.filter((item) =>
    SEARCH_FIELDS.some((key) => String(item[key] ?? "").toLowerCase().includes(needle))
  );
}
<% if (filtering) { -%>

const FILTER_RESERVED = new Set([<%- reservedKeysLiteral %>]);

function applyFilters(items, query) {
  const entries = Object.entries(query).filter(
    ([key, value]) => !FILTER_RESERVED.has(key) && value !== undefined && value !== ""
  );
  if (entries.length === 0) return items;
  return items.filter((item) =>
    entries.every(([key, value]) => {
      if (Array.isArray(value)) return value.map(String).includes(String(item[key]));
      return String(item[key] ?? "") === String(value);
    })
  );
}
<% } -%>

exports.getAll = async (req, res) => {
  let items = applySearch(store, req.query.search);
<% if (filtering) { -%>
  items = applyFilters(items, req.query);
<% } -%>
  const total = items.length;
<% if (pagination) { -%>
  const page = Math.max(1, parseInt(req.query.page, 10) || 1);
  const limit = Math.max(1, Math.min(100, parseInt(req.query.limit, 10) || 10));
  const start = (page - 1) * limit;
  items = items.slice(start, start + limit);
<% } -%>

  res.json({
    message: "Berhasil mendapatkan data",
    data: {
      items,
      total,
<% if (pagination) { -%>
      page,
      limit,
      totalPages: Math.ceil(total / limit),
<% } -%>
    },
  });
};

exports.getById = async (req, res) => {
  const item = store.find((entry) => String(entry.id) === String(req.params.id));
  if (!item) {
    return res.status(404).json({ message: "Data tidak ditemukan", data: null });
  }
  res.json({ message: "Berhasil mendapatkan data", data: item });
};

exports.create = async (req, res) => {
  const item = {
<% if (autoId) { -%>
    id: `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`,
<% } -%>
<% fields.forEach(function (field) { -%>
    <%- field.key %>: cast(FIELD_TYPES[<%- field.literal %>], req.body<%- field.access %>),
<% }); -%>
  };

  store.push(item);
  res.status(201).json({ message: "Data berhasil dibuat", data: item });
};

exports.update = async (req, res) => {
  const item = store.find((entry) => String(entry.id) === String(req.params.id));
  if (!item) {
    return res.status(404).json({ message: "Data tidak ditemukan", data: null });
  }
<% fields.forEach(function (field) { -%>
  if (req.body<%- field.access %> !== undefined) {
    item<%- field.access %> = cast(FIELD_TYPES[<%- field.literal %>], req.body<%- field.access %>);
  }
<% }); -%>

  res.json({ message: "Data berhasil diperbarui", data: item });
};

exports.remove = async (req, res) => {
  const index = store.findIndex((entry) => String(entry.id) === String(req.params.id));
  if (index === -1) {
    return res.status(404).json({ message: "Data tidak ditemukan", data: null });
  }
  const [removed] = store.splice(index, 1);
  res.json({ message: "Data berhasil dihapus", data: removed });
};
