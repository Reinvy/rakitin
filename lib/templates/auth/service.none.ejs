// User Service (Auth with In-Memory Store)
const bcrypt = require("bcryptjs");
const jwt = require("jsonwebtoken");

const USERS_STORE = [];
let nextId = 1;

function sanitizeUser(user) {
  if (!user) return null;
  const { password, ...safeUser } = user;
  return safeUser;
}

function generateToken(user) {
  const secret = process.env.JWT_SECRET || "default_jwt_secret";
  const expiresIn = process.env.JWT_EXPIRES_IN || "7d";
  return jwt.sign(
    { id: user.id, email: user.email, role: user.role || "user" },
    secret,
    { expiresIn }
  );
}

async function register({ email, password, name, role }) {
  const existing = USERS_STORE.find((u) => u.email === email);
  if (existing) {
    const error = new Error("Email sudah terdaftar");
    error.statusCode = 409;
    throw error;
  }

  const hashedPassword = await bcrypt.hash(password, 10);
  const user = {
    id: nextId++,
    email,
    password: hashedPassword,
    name: name || null,
    role: role || "user",
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
  };
  USERS_STORE.push(user);

  const token = generateToken(user);
  return { user: sanitizeUser(user), token };
}

async function login({ email, password }) {
  const user = USERS_STORE.find((u) => u.email === email);
  if (!user) {
    const error = new Error("Email atau password salah");
    error.statusCode = 401;
    throw error;
  }

  const isMatch = await bcrypt.compare(password, user.password);
  if (!isMatch) {
    const error = new Error("Email atau password salah");
    error.statusCode = 401;
    throw error;
  }

  const token = generateToken(user);
  return { user: sanitizeUser(user), token };
}

async function getProfile(userId) {
  const user = USERS_STORE.find((u) => u.id === Number(userId));
  if (!user) {
    const error = new Error("Pengguna tidak ditemukan");
    error.statusCode = 404;
    throw error;
  }
  return sanitizeUser(user);
}

async function updateProfile(userId, { name, email }) {
  const userIndex = USERS_STORE.findIndex((u) => u.id === Number(userId));
  if (userIndex === -1) {
    const error = new Error("Pengguna tidak ditemukan");
    error.statusCode = 404;
    throw error;
  }
  if (email && email !== USERS_STORE[userIndex].email) {
    const existing = USERS_STORE.find((u) => u.email === email);
    if (existing) {
      const error = new Error("Email sudah digunakan");
      error.statusCode = 409;
      throw error;
    }
  }

  USERS_STORE[userIndex] = {
    ...USERS_STORE[userIndex],
    ...(name !== undefined && { name }),
    ...(email !== undefined && { email }),
    updatedAt: new Date().toISOString(),
  };

  return sanitizeUser(USERS_STORE[userIndex]);
}

async function changePassword(userId, { oldPassword, newPassword }) {
  const userIndex = USERS_STORE.findIndex((u) => u.id === Number(userId));
  if (userIndex === -1) {
    const error = new Error("Pengguna tidak ditemukan");
    error.statusCode = 404;
    throw error;
  }

  const isMatch = await bcrypt.compare(oldPassword, USERS_STORE[userIndex].password);
  if (!isMatch) {
    const error = new Error("Password lama salah");
    error.statusCode = 400;
    throw error;
  }

  USERS_STORE[userIndex].password = await bcrypt.hash(newPassword, 10);
  USERS_STORE[userIndex].updatedAt = new Date().toISOString();
  return { message: "Password berhasil diubah" };
}

async function getAll(req) {
  return USERS_STORE.map(sanitizeUser);
}

async function getById(req) {
  const id = req.params?.id || req;
  const user = USERS_STORE.find((u) => u.id === Number(id));
  return sanitizeUser(user);
}

async function create(req) {
  const data = req.body || req;
  return register(data);
}

async function update(req) {
  const id = req.params?.id;
  const data = req.body || {};
  return updateProfile(id, data);
}

async function remove(req) {
  const id = req.params?.id || req;
  const index = USERS_STORE.findIndex((u) => u.id === Number(id));
  if (index !== -1) {
    USERS_STORE.splice(index, 1);
  }
  return { message: "Pengguna berhasil dihapus" };
}

module.exports = {
  register,
  login,
  getProfile,
  updateProfile,
  changePassword,
  getAll,
  getById,
  create,
  update,
  remove,
};
