/**
 * WebSocket handler untuk modul `<%= kebab %>` (dikelola rakitin).
 *
 * Event: `<%= kebab %>`
 * Balasan otomatis: `{ event: "<%= kebab %>:ack", data: <nilai onMessage> }`.
 *
 * Contoh pesan klien:
 *   { "event": "<%= kebab %>", "data": { "action": "list" } }
 *   { "event": "<%= kebab %>", "data": { "action": "get", "id": "123" } }
 *   { "event": "<%= kebab %>", "data": { "action": "create", "body": { ... } } }
 *   { "event": "<%= kebab %>", "data": { "action": "update", "id": "123", "body": { ... } } }
 *   { "event": "<%= kebab %>", "data": { "action": "delete", "id": "123" } }
 */

const service = require("<%= serviceRequire %>");

/**
 * Bangun objek mirip `req` Express: seluruh service modul (`getAll`, `getById`,
 * `create`, `update`, `remove`) membaca `req.query` / `req.params` / `req.body`.
 */
function toRequest(data) {
  const payload = data && typeof data === "object" ? data : {};
  return {
    query: payload.query || payload,
    params: { ...payload, ...(payload.params || {}) },
    body: payload.body || payload,
  };
}

module.exports = {
  event: "<%= kebab %>",

  /**
   * Delegasikan pesan ke service modul.
   * @param {import("ws").WebSocket} ws
   * @param {object} [data] Payload `data` dari klien.
   * @param {object} [ctx] Konteks ({ event, wss, send }).
   * @returns {Promise<any>} Nilai yang dikirim sebagai `<%= kebab %>:ack`.
   */
  async onMessage(ws, data = {}, ctx = {}) {
    const payload = data && typeof data === "object" ? data : {};
    const action = payload.action || "list";
    const req = toRequest(payload);

    switch (action) {
      case "get":
        return service.getById(req);
      case "create":
        return service.create(req);
      case "update":
        return service.update(req);
      case "delete":
        return service.remove(req);
      case "list":
      default:
        return service.getAll(req);
    }
  },
};
