/**
 * Registry handler WebSocket (dikelola rakitin - aman diregenerasi).
 *
 * Setiap modul mendaftarkan handler-nya di region marker (simbol `rakitin:ws`)
 * di bagian bawah file ini; `rakitin add websocket --module <m>` menyisipkan
 * `require` handler modul tersebut beserta pemanggilan `register("<m>", handler)`
 * ke region itu.
 *
 * Bentuk handler: `{ event: "<nama>", onMessage(ws, data, ctx) }`. Nilai yang
 * dikembalikan `onMessage` dikirim sebagai `{ event: "<nama>:ack", data }`.
 * Tulis kode kustom DI LUAR region marker.
 */

const handlers = {};

/**
 * Daftarkan handler. `name` dipakai sebagai fallback bila `handler.event` kosong.
 * @param {string} name
 * @param {{event?: string, onMessage: Function}} handler
 * @returns {{event?: string, onMessage: Function}}
 */
function register(name, handler) {
  if (!handler || typeof handler.onMessage !== "function") {
    throw new Error(`Handler "${name}" tidak valid: wajib punya onMessage().`);
  }
  handlers[handler.event || name] = handler;
  return handler;
}

/** Kirim payload JSON bila socket masih terbuka. */
function send(ws, payload) {
  if (!ws || ws.readyState !== 1) return false;
  ws.send(JSON.stringify(payload));
  return true;
}

/**
 * Tangani satu pesan masuk: dispatch ke handler terdaftar lalu kirim ack.
 * @param {import("ws").WebSocket} ws
 * @param {{event: string, data?: any}} payload
 * @param {object} [ctx]
 * @returns {Promise<boolean>} `true` bila pesan ditangani handler.
 */
async function dispatch(ws, payload, ctx = {}) {
  const event = payload && payload.event;
  if (typeof event !== "string" || !event) {
    send(ws, {
      event: "error",
      data: { message: "Payload tidak valid. Gunakan { event, data }." },
    });
    return false;
  }

  const handler = handlers[event];
  if (!handler) {
    send(ws, {
      event: "error",
      data: { message: `Event tidak dikenal: ${event}` },
    });
    return false;
  }

  try {
    const data = await handler.onMessage(ws, payload.data, { ...ctx, event, send });
    send(ws, {
      event: `${event}:ack`,
      data: data === undefined ? payload.data : data,
    });
    return true;
  } catch (error) {
    send(ws, {
      event: "error",
      data: { message: error && error.message ? error.message : String(error) },
    });
    return false;
  }
}

