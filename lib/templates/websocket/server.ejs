/**
 * WebSocket layer (dikelola rakitin - aman diregenerasi).
 *
 * Protokol: setiap pesan klien berbentuk JSON `{ "event": "<nama>", "data": <payload> }`.
 * Balasan dari server:
 *   - `{ "event": "connected" }`               saat koneksi terbuka
 *   - `{ "event": "<event>:ack", "data": ... }` saat pesan berhasil ditangani
 *   - `{ "event": "error", "data": { "message": "..." } }` saat payload tidak
 *     valid, event tidak dikenal, atau handler melempar error
 *
 * Cara pakai:
 *   const http = require("http");
 *   const app = require("./app");
 *   const { attachWebSocket } = require("./app/ws");
 *
 *   const server = http.createServer(app);
 *   attachWebSocket(server, { path: "<%= path %>" });
 *   server.listen(3000);
 */

const { WebSocketServer } = require("ws");
const { dispatch } = require("./handlers");

const DEFAULT_PATH = "<%= path %>";
const HEARTBEAT_INTERVAL_MS = 30000;
const OPEN = 1;

/** Kirim payload JSON bila socket masih terbuka. */
function send(ws, payload) {
  if (!ws || ws.readyState !== OPEN) return false;
  ws.send(JSON.stringify(payload));
  return true;
}

/** Parse payload JSON tanpa melempar. */
function parseMessage(raw) {
  try {
    return JSON.parse(raw.toString());
  } catch (_error) {
    return null;
  }
}

/**
 * Buat WebSocketServer yang menempel pada HTTP server.
 * @param {{server: import("http").Server, path?: string}} options
 * @returns {import("ws").WebSocketServer}
 */
function createWebSocketServer({ server, path = DEFAULT_PATH } = {}) {
  const wss = new WebSocketServer({ server, path });

  wss.on("connection", (ws) => {
    ws.isAlive = true;
    ws.on("pong", () => {
      ws.isAlive = true;
    });
    ws.on("error", () => {
      // Biarkan heartbeat menutup socket yang rusak (hindari unhandled error).
    });

    send(ws, { event: "connected" });

    ws.on("message", (raw) => {
      const payload = parseMessage(raw);
      if (!payload || typeof payload.event !== "string" || !payload.event) {
        send(ws, {
          event: "error",
          data: { message: "Payload tidak valid. Gunakan { event, data }." },
        });
        return;
      }
      dispatch(ws, payload, { wss, send });
    });
  });

  // Heartbeat: socket yang tidak menjawab ping dalam 30 detik dihentikan.
  const heartbeat = setInterval(() => {
    wss.clients.forEach((ws) => {
      if (ws.isAlive === false) {
        ws.terminate();
        return;
      }
      ws.isAlive = false;
      ws.ping();
    });
  }, HEARTBEAT_INTERVAL_MS);
  if (typeof heartbeat.unref === "function") heartbeat.unref();

  wss.on("close", () => clearInterval(heartbeat));

  return wss;
}

/**
 * Tempelkan WebSocket ke HTTP server (helper utama).
 * @param {import("http").Server} server
 * @param {{path?: string}} [options]
 * @returns {import("ws").WebSocketServer}
 */
function attachWebSocket(server, options = {}) {
  return createWebSocketServer({ server, path: options.path || DEFAULT_PATH });
}

module.exports = {
  attachWebSocket,
  createWebSocketServer,
  DEFAULT_PATH,
  HEARTBEAT_INTERVAL_MS,
};
